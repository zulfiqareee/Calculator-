# Server-side AI proxy secret (never prefixed with VITE_ so it stays off client bundles)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public app origin used for link generation and CORS allowlist
APP_URL="MY_APP_URL"

# Backend Admin Authentication (required for Admin Panel server sync & AI proxy)
# Configure ADMIN_EMAIL and ADMIN_PASSWORD (or a precomputed scrypt:<salt>:<hex> ADMIN_PASSWORD_HASH)
ADMIN_EMAIL="zulfiqar1hasan@gmail.com"
ADMIN_PASSWORD="SET_STRONG_ADMIN_PASSWORD_HERE"
# Optional: 64+ hex char HMAC secret for signing session tokens across restarts
SESSION_SECRET=""

# Optional Firebase Web Config (public identifiers; protect Firestore with firestore.rules + Firebase Auth)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_APP_ID=""
